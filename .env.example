# =============================================================================
# Smart Frame Engine - environment configuration
# Copy to `.env` and adjust. Never commit your real `.env`.
#
# Runtime settings (Immich, TMDB, Fraimic, display, eInk, scheduler) can also be
# edited from the web UI / `PUT /api/config`. Values saved there are stored in
# /data/config.json and take precedence over this file. Use
# `POST /api/config/reset` to fall back to the values below again.
# =============================================================================

# --- Docker Compose (host side) ----------------------------------------------
# Host port published by docker-compose.yml.
HOST_PORT=8080
# Host user/group owning ./data (run `id -u` / `id -g`).
PUID=1000
PGID=1000

# --- Security ----------------------------------------------------------------
# Password of the "admin" web UI login. When set, every route except /api/health, the
# login and the public images needs a login session or the API key, and an API key is
# generated into /data/secrets.json if APP_API_KEY is empty (shown in the UI).
# Leave empty (with APP_API_KEY empty too) for pure LAN usage without authentication.
ADMIN_PASSWORD=
# API key for Home Assistant and other clients: X-API-Key header,
# "Authorization: Bearer <key>" or ?api_key=. Optional when ADMIN_PASSWORD is set (a key is
# generated and can be regenerated from the UI); setting it here pins it.
# Without ADMIN_PASSWORD, all POST/PUT/DELETE routes and /api/config require it.
# Generate one with: openssl rand -hex 32
APP_API_KEY=
# Lifetime of a web UI login, in hours (default one week).
SESSION_TTL_HOURS=168
# Optional key signing the login cookies (generated into /data/secrets.json if empty).
SESSION_SECRET=
# Keep /api/current.jpg, /api/current.bin and /api/preview.jpg readable without a key
# (needed by Home Assistant Generic Camera). Set to false to require ?api_key=.
PUBLIC_IMAGE_ENDPOINTS=true
# Advertise _smartframe._tcp.local. over mDNS (Docker needs network_mode: host for it).
ZEROCONF_ENABLED=true
# Max size of uploaded/downloaded images, in MB.
MAX_UPLOAD_MB=20
# Reject external image URLs (posters, album covers, Home Assistant pictures) resolving to
# private/loopback/link-local addresses; every redirect target is checked too.
BLOCK_PRIVATE_URLS=false
# Comma-separated hosts or CIDRs allowed even when BLOCK_PRIVATE_URLS=true,
# e.g. homeassistant.local,192.168.1.0/24
URL_ALLOWLIST=

# --- Reverse proxy -----------------------------------------------------------
# Sub-path when served behind a proxy, e.g. /fraimic (empty = served at /).
ROOT_PATH=
# Comma-separated allowed CORS origins (* = any).
CORS_ORIGINS=*
# Proxy IPs trusted for X-Forwarded-Proto / X-Forwarded-For (* = any).
FORWARDED_ALLOW_IPS=*

# --- Server ------------------------------------------------------------------
LOG_LEVEL=INFO
# Container-internal port; change HOST_PORT instead when using Docker Compose.
# PORT=8080
# DATA_DIR=/data

# --- Immich (runtime default) ------------------------------------------------
# Seeds one Immich account named "default". Add more accounts (a partner, a shared
# library) under immich.accounts in the settings / PUT /api/config.
# A LAN address needs URL_ALLOWLIST when BLOCK_PRIVATE_URLS=true.
IMMICH_URL=http://immich.local:2283
IMMICH_API_KEY=

# --- TMDB movie & TV posters (runtime default) -------------------------------
# A v3 API key or a v4 read access token (https://www.themoviedb.org/settings/api).
# Without it, POST /api/display/tmdb falls back to the Home Assistant picture, to
# /data/assets/tmdb_fallback.png, then to a title card.
TMDB_API_KEY=
# Poster language and region, e.g. fr-FR or en-US: regional posters are preferred, then
# the same language, textless artwork and English.
TMDB_LANGUAGE=fr-FR

# --- Fraimic frame (runtime default) -----------------------------------------
# Hostname, IP or base URL of the frame (see fraimic.local/info for its IP).
# Inside Docker, .local (mDNS) names usually do NOT resolve on the default bridge
# network: use the frame's IP address and give it a DHCP reservation.
FRAIMIC_HOST=fraimic.local
# continuous = mains powered, always reachable
# deepsleep  = battery powered, uploads are queued until the frame wakes up
FRAIMIC_POWER_MODE=continuous
# 133 = 13.3" (1200x1600), 315 = 31.5" (1440x2560)
FRAIMIC_PANEL=133
# portrait | landscape
ORIENTATION=portrait

# --- Smart Mix (runtime default) ---------------------------------------------
# Weighted playlist of source rules for scheduled refreshes (entries are configured in
# smart_mix.entries via the API/UI). A pinned scheduler.source_rule still takes precedence.
SMART_MIX_ENABLED=false

# --- Scheduler (runtime default) ---------------------------------------------
# Replays the active source rule (the pinned scheduler.source_rule, else the last
# manual display) every REFRESH_INTERVAL_HOURS hours. Any display resets the timer.
SCHEDULER_ENABLED=false
REFRESH_INTERVAL_HOURS=6
# Optional no-refresh window in local time (24h HH:MM, may cross midnight). A refresh
# that falls inside runs when the window ends. Leave both empty to disable.
QUIET_HOURS_START=
QUIET_HOURS_END=
# IANA timezone of the quiet hours, e.g. Europe/Paris (containers run in UTC otherwise)
TZ=UTC
